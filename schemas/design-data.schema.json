{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tasksystem:design-data:v1",
  "title": "Structured design binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["specId", "specDigest"],
  "properties": {
    "specId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "specDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Data inside design V2. The enclosing artifact carries its version. Runtime checks the related structured specification and its current digest."
}
