{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:tasksystem:approval:v1",
  "title":"Content-bound approval record",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","id","revision","target","status","question","notice","scope","options","createdAt","updatedAt","history"],
  "properties":{
    "schemaVersion":{"const":1},
    "id":{"$ref":"#/$defs/digest"},
    "revision":{"$ref":"#/$defs/revision"},
    "target":{"$ref":"#/$defs/target"},
    "status":{"enum":["pending","approved","rejected","declined","needs-clarification","revoked"]},
    "question":{"$ref":"#/$defs/text"},
    "notice":{"$ref":"#/$defs/text"},
    "scope":{
      "type":"object","additionalProperties":false,
      "required":["paths","effects"],
      "properties":{
        "paths":{"type":"array","items":{"$ref":"#/$defs/text"}},
        "effects":{"const":["permit-next-harness-gate-for-bound-content"]}
      }
    },
    "options":{
      "type":"array","minItems":2,"maxItems":2,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","label","description"],
        "properties":{"id":{"enum":["approve","reject"]},"label":{"$ref":"#/$defs/text"},"description":{"$ref":"#/$defs/text"}}
      }
    },
    "createdAt":{"$ref":"#/$defs/time"},
    "updatedAt":{"$ref":"#/$defs/time"},
    "history":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/event"}}
  },
  "$defs":{
    "text":{"type":"string","minLength":1},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "uuid":{"type":"string","pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "revision":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "time":{"type":"string","format":"date-time","description":"Runtime requires canonical ISO UTC roundtrip and chronological consistency."},
    "target":{
      "oneOf":[
        {
          "type":"object","additionalProperties":false,"required":["kind","artifactKind","id","digest"],
          "properties":{"kind":{"const":"artifact"},"artifactKind":{"enum":["spec","design","research","report","review","decision","lesson","handoff"]},"id":{"$ref":"#/$defs/uuid"},"digest":{"$ref":"#/$defs/digest"}}
        },
        {
          "type":"object","additionalProperties":false,"required":["kind","id","digest"],
          "properties":{"kind":{"const":"task"},"id":{"$ref":"#/$defs/uuid"},"digest":{"$ref":"#/$defs/digest"}}
        },
        {
          "type":"object","additionalProperties":false,"required":["kind","id","digest"],
          "properties":{"kind":{"const":"plan"},"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},"digest":{"$ref":"#/$defs/digest"}}
        }
      ]
    },
    "event":{
      "type":"object","additionalProperties":false,
      "required":["at","event","revision","status","actor","answer","comment"],
      "properties":{
        "at":{"$ref":"#/$defs/time"},
        "event":{"enum":["created","answered"]},
        "revision":{"$ref":"#/$defs/revision"},
        "status":{"enum":["pending","approved","rejected","declined","needs-clarification","revoked"]},
        "actor":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/text"}]},
        "answer":{"enum":[null,"approve","reject","decline","custom","revoke"]},
        "comment":{"oneOf":[{"type":"null"},{"type":"string"}]}
      }
    }
  },
  "description":"Runtime additionally checks ID/filename/target digest agreement, chronological/history invariants, option uniqueness, paths, current target and byte/event limits. Actor identity and evidence are not authenticated."
}
