{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tasksystem:specification-data:v1",
  "title": "Structured specification data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","originalRequest","outcome","requirements","scope","constraints","nonGoals","openQuestions"],
  "properties": {
    "schemaVersion": {"const":1},
    "originalRequest": {"$ref":"#/$defs/text"},
    "outcome": {
      "type":"object",
      "additionalProperties":false,
      "required":["statement","evidencePlan"],
      "properties":{"statement":{"$ref":"#/$defs/text"},"evidencePlan":{"$ref":"#/$defs/text"}}
    },
    "requirements": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/requirement"}},
    "scope": {"type":"array","items":{"$ref":"#/$defs/path"}},
    "constraints": {"$ref":"#/$defs/texts"},
    "nonGoals": {"$ref":"#/$defs/texts"},
    "openQuestions": {"$ref":"#/$defs/texts"}
  },
  "$defs": {
    "text": {"type":"string","minLength":1,"description":"Runtime also rejects whitespace-only strings."},
    "texts": {"type":"array","items":{"$ref":"#/$defs/text"}},
    "path": {"type":"string","minLength":1,"description":"Runtime requires canonical project-relative safe paths, containment and no symlink ancestors."},
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9-]{0,63}$"},
    "requirement": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","statement","scenarios"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "statement":{"$ref":"#/$defs/text"},
        "scenarios":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/scenario"}}
      }
    },
    "scenario": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","given","when","then"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "given":{"$ref":"#/$defs/text"},
        "when":{"$ref":"#/$defs/text"},
        "then":{"$ref":"#/$defs/text"}
      }
    }
  },
  "description": "Prepared/stored data, not raw API input. Runtime additionally checks identifier uniqueness, byte limits and bindings. This schema does not establish semantic truth."
}
