{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tasksystem:organic-assessment:v1",
  "title": "Organic classification facts embedded in a task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "request", "intent", "authorization", "understanding",
    "uncertainty", "risk", "riskCategories", "continuity", "evidence",
    "preferredRoute"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "request": {"$ref": "#/$defs/text"},
    "intent": {"enum": ["change", "read-only"]},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "actor", "reference"],
      "properties": {
        "status": {"enum": ["authorized", "missing", "declined"]},
        "actor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
        "reference": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "missing"}}},
        "then": {
          "properties": {"actor": {"type": "null"}, "reference": {"type": "null"}}
        },
        "else": {
          "properties": {
            "actor": {"$ref": "#/$defs/text"},
            "reference": {"$ref": "#/$defs/text"}
          }
        }
      }]
    },
    "understanding": {"enum": ["sufficient", "insufficient"]},
    "uncertainty": {"enum": ["resolved", "unresolved"]},
    "risk": {"enum": ["contained", "named", "unknown"]},
    "riskCategories": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": [
        "security", "data-integrity", "public-contract", "concurrency",
        "delivery", "external-effects", "verification-gap", "other"
      ]}
    },
    "continuity": {"enum": ["diff-sufficient", "record-required"]},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/text"}
    },
    "preferredRoute": {"enum": ["auto", "sdd"]}
  },
  "allOf": [
    {
      "if": {"properties": {"risk": {"const": "contained"}}},
      "then": {"properties": {"riskCategories": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"risk": {"const": "named"}}},
      "then": {"properties": {"riskCategories": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "text": {
      "type": "string", "minLength": 1,
      "description": "Runtime rejects whitespace-only strings without rewriting the original request."
    }
  },
  "description": "Normalized stored facts, not a risk oracle. Raw input may omit preferredRoute (auto). Route is derived and is never accepted as an input field. Operator attribution does not authenticate identity, consent or semantic truth."
}
